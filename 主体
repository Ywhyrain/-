function detectNetworkLocation() {
  var badge = document.getElementById('network-badge'), loc = document.getElementById('network-location');
  if (badge) badge.style.display = 'inline-flex'; if (loc) loc.textContent = t('locating');
  var apis = [
    { url: 'https://ipapi.co/json/', parse: d => ({ ip: d.ip, country: d.country_name, countryCode: d.country_code, city: d.city }) },
    { url: 'https://ipwho.is/', parse: d => { if (d.success === false) throw new Error('fail'); return { ip: d.ip, country: d.country, countryCode: d.country_code, city: d.city }; } },
    { url: 'https://ipinfo.io/json', parse: d => ({ ip: d.ip, country: d.country, countryCode: d.country, city: d.city }) }
  ];
  function tryNext(i) {
    if (i >= apis.length) { renderNetworkBadge(); return; }
    fetch(apis[i].url).then(res => res.json()).then(d => {
      var info = apis[i].parse(d);
      if (!info.ip && !info.countryCode) throw new Error('empty');
      networkInfo.country = info.country || ''; networkInfo.countryCode = (info.countryCode || '').toUpperCase();
      networkInfo.city = info.city || ''; networkInfo.ip = info.ip || '';
      renderNetworkBadge();
      if (currentLangSetting === 'auto') { var newLang = resolveLang(); if (newLang !== currentLang) { currentLang = newLang; renderAllTexts(); fetchQuote(); } }
    }).catch(() => { tryNext(i + 1); });
  }
  tryNext(0);
}
