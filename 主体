    var titleText = '起始页';
    if (tab.url.startsWith('SEARCH:')) titleText = '搜索: ' + tab.url.replace('SEARCH:', '');
    else if (tab.url !== 'home') titleText = tab.url.replace(/^https?:\/\//, '').split('/')[0];
    card.innerHTML = `<div class="tab-card-header"><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${titleText}</span><button class="close-tab" onclick="closeTab('${tab.id}')">✕</button></div><div class="tab-card-preview">${tab.url === 'home' ? '🏠' : (tab.isLoading ? '⏳' : '🌐')}</div>`;
    $tabsView.appendChild(card);
  });
  var addCard = document.createElement('div'); addCard.className = 'tab-card add-tab-card';
  addCard.innerHTML = `<span>+</span><span style="font-size:14px;">${t('newTab')}</span>`;
  addCard.onclick = () => { createNewTab(); toggleTabsView(false); };
  $tabsView.appendChild(addCard);
}
function addHistory(url) { if (url === 'home' || url.startsWith('SEARCH:')) return; historyList.unshift({ url: url, time: Date.now() }); if (historyList.length > 100) historyList.pop(); saveHistory(); }
function togglePanel(type) {
  if (!type) { $panelView.classList.remove('show'); currentPanelType = null; return; }
  currentPanelType = type; $panelView.classList.add('show'); $panelContent.innerHTML = '';
  if (type === 'bookmarks') {
    $panelTitle.textContent = t('bookmarks');
    if (bookmarks.length === 0) { $panelContent.innerHTML = `<p style="text-align:center;color:var(--text-muted);margin-top:50px;">${t('noBookmarks')}</p>`; return; }
    bookmarks.forEach((b, index) => {
      var el = document.createElement('div'); el.className = 'list-item';
      el.innerHTML = `<div style="flex:1;overflow:hidden;"><div class="list-item-title">${b.title}</div><div class="list-item-url">${b.url}</div></div><button class="icon-btn" style="color:var(--danger);cursor:pointer;" onclick="removeBookmark(${index})">${t('delete')}</button>`;
      el.onclick = e => { if (e.target.tagName !== 'BUTTON') { navigate(b.url); togglePanel(false); } };
      $panelContent.appendChild(el);
    });
  } else if (type === 'history') {
    $panelTitle.textContent = t('history');
    if (historyList.length === 0) { $panelContent.innerHTML = `<p style="text-align:center;color:var(--text-muted);margin-top:50px;">${t('noHistory')}</p>`; return; }
    var clearBtn = document.createElement('div'); clearBtn.className = 'clear-all-btn'; clearBtn.textContent = t('clearAllHistory'); clearBtn.onclick = clearAllHistory; $panelContent.appendChild(clearBtn);
    historyList.forEach((h, index) => {
      var el = document.createElement('div'); el.className = 'list-item';
      el.innerHTML = `<div style="flex:1;overflow:hidden;"><div class="list-item-title">${h.url.replace(/^https?:\/\//, '')}</div><div class="list-item-url">${new Date(h.time).toLocaleString()}</div></div><button class="icon-btn" style="color:var(--danger);cursor:pointer;" onclick="removeHistory(${index})">${t('delete')}</button>`;
      el.onclick = e => { if (e.target.tagName !== 'BUTTON') { navigate(h.url); togglePanel(false); } };
      $panelContent.appendChild(el);
    });
  }
}
function removeBookmark(index) { bookmarks.splice(index, 1); saveBookmarks(); togglePanel('bookmarks'); }
function removeHistory(index) { historyList.splice(index, 1); saveHistory(); togglePanel('history'); }
function clearAllHistory() { if (confirm(t('alertClearHistory'))) { historyList = []; saveHistory(); togglePanel('history'); } }
function saveCurrentPage() {
  var tab = tabs.find(t => t.id === activeTabId);
  if (!tab || tab.url === 'home' || tab.url.startsWith('SEARCH:')) return alert(t('alertBookmarkHome'));
  if (bookmarks.some(b => b.url === tab.url)) return alert(t('alertBookmarkExist'));
  var title = prompt(t('promptBookmarkName'), tab.url.replace(/^https?:\/\//, '').split('/')[0]);
  if (title) { bookmarks.push({ title: title, url: tab.url }); saveBookmarks(); alert(t('alertBookmarkAdded')); }
}
$urlInput.addEventListener('dblclick', saveCurrentPage);
function renderShortcuts() {
  var grid = document.getElementById('shortcuts-grid'); grid.innerHTML = '';
  shortcuts.forEach((s, index) => {
    var item = document.createElement('div'); item.className = 'shortcut-item';
    item.innerHTML = `<div class="delete-shortcut" onclick="removeShortcut(event,${index})">✕</div><div class="shortcut-icon">${s.title.charAt(0).toUpperCase()}</div><div class="shortcut-label">${s.title}</div>`;
    item.onclick = () => { if (!isEditingShortcuts) navigate(s.url); };
    grid.appendChild(item);
  });
  if (isEditingShortcuts) {
    var addBtn = document.createElement('div'); addBtn.className = 'shortcut-item';
    addBtn.innerHTML = `<div class="shortcut-icon add-shortcut-btn">+</div><div class="shortcut-label" style="color:var(--tint-color)">${t('add')}</div>`;
    addBtn.onclick = addShortcut; grid.appendChild(addBtn);
  }
}
function toggleEditShortcuts() {
  isEditingShortcuts = !isEditingShortcuts;
  document.getElementById('edit-shortcuts-btn').textContent = isEditingShortcuts ? t('done') : t('edit');
  document.getElementById('shortcuts-grid').classList.toggle('editing', isEditingShortcuts);
  renderShortcuts();
}
function removeShortcut(e, index) { e.stopPropagation(); shortcuts.splice(index, 1); saveShortcuts(); renderShortcuts(); }
function addShortcut() {
  var title = prompt(t('promptShortcutName')), url = prompt(t('promptShortcutUrl'));
  if (title && url) { shortcuts.push({ title: title, url: url }); saveShortcuts(); renderShortcuts(); }
}
function updateGreeting() {
  var h = new Date().getHours(), textKey = 'greetingAfternoon';
  if (h < 12) textKey = 'greetingMorning'; else if (h >= 18) textKey = 'greetingEvening';
  document.getElementById('greeting-text').textContent = t(textKey) + t('greetingReady');
}
init();
</script>
</body>
</html>