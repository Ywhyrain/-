function fetchFastest(targetUrl, timeoutMs) {
  return new Promise((resolve, reject) => {
    var controllers = [], finished = false;
    var timeoutTimer = setTimeout(() => {
      if (finished) return;
      finished = true; controllers.forEach(c => c.abort()); reject(new Error('Timeout'));
    }, timeoutMs || 1500);

    CORS_PROXIES.forEach(proxyPrefix => {
      if (finished) return;
      var controller = new AbortController(); controllers.push(controller);
      fetch(proxyPrefix + encodeURIComponent(targetUrl), { signal: controller.signal })
        .then(res => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.text(); })
        .then(text => {
          if (finished) return;
          finished = true; clearTimeout(timeoutTimer); controllers.forEach(c => c.abort()); resolve(text);
        }).catch(err => { });
    });
  });
}

function fetchWithFallback(targetUrl, timeoutMs) {
  var index = 0;
  function tryNext() {
    if (index >= CORS_PROXIES.length) return Promise.reject(new Error('All proxies failed'));
    var proxy = CORS_PROXIES[index++], controller = new AbortController();
    var timer = setTimeout(() => controller.abort(), timeoutMs || 3000);
    return fetch(proxy + encodeURIComponent(targetUrl), { signal: controller.signal })
      .then(res => { clearTimeout(timer); if (!res.ok) throw new Error('HTTP ' + res.status); return res.text(); })
      .catch(() => { clearTimeout(timer); return tryNext(); });
  }
  return tryNext();
