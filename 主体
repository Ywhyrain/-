  var requestJson = url => fetch(url).then(res => { if (!res.ok) throw new Error('HTTP ' + res.status); return res.json(); });
  if (currentLang === 'zh') {
    requestJson('https://v1.hitokoto.cn/?c=d&c=k').then(data => {
